# Credenciais do SinricPro (https://portal.sinric.pro)
#   App Key / App Secret : menu Credentials (a mesma da sua conta,
#                           compartilhada entre todos os dispositivos)
#   Device ID             : menu Devices, no dispositivo do tipo Motion Sensor
SINRIC_APP_KEY=
SINRIC_APP_SECRET=
SINRIC_DEVICE_ID=

# Logs detalhados do SDK (1 para ligar)
SINRIC_DEBUG=0

# --- Sensor mmWave C4001 --------------------------------------------------
# GPIO (BCM) ligado ao pino OUT do sensor.
OUT_GPIO=27

# Inverta para 0 se o painel mostrar presença ao contrário (SIM quando
# vazio, NÃO quando tem alguém).
OUT_ATIVO_ALTO=1

# Quanto tempo sem detecção até marcar "ausente". A detecção de presença é
# imediata; só a ausência tem esse atraso, para não ficar piscando quando a
# pessoa fica parada e o mmWave perde o rastreio por um instante.
ATRASO_AUSENCIA_SEG=3.0

# Se o serviço/Pi reiniciar ou a Sinric cair e voltar dentro desse tempo
# (segundos), presença e contagem são mantidas e nada é reenviado à Sinric
# se o estado não mudou. Passou disso, reenvia o estado atual.
TOLERANCIA_OFFLINE_SEG=300

# Porta do painel HTTP (padrão 8081 - o sensor-pi já usa a 8080 neste mesmo
# Raspberry Pi).
PORTA_WEB=8081

# Baud rate da UART (pinos RX/TX) usada para ajustar alcance/sensibilidade
# pelo painel web ou pelo configurar_sensor.py. Precisa bater com o do
# sensor (padrão de fábrica do C4001 é 9600).
SENSOR_UART_BAUD=9600
