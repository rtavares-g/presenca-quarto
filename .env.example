# --- Home Assistant ---------------------------------------------------------
# A presença vai para o HA pelo broker MQTT (add-on Mosquitto). Host, porta,
# usuário e senha ficam em ~/.config/mqtt-ha.json (fora do git):
#   {"host": "192.168.1.211", "port": 1883, "usuario": "...", "senha": "..."}
# MQTT_CONFIG=/home/usuario/.config/mqtt-ha.json

# Validação pelo Kinect: cada nova detecção do mmWave só vira presença no HA
# depois que o serviço kinect-quarto confirmar uma pessoa. Se o Kinect ficar
# fora do ar (estado.json sem atualizar) por mais que KINECT_PARADO_SEG, a
# presença passa a usar só o mmWave. KINECT_VALIDAR=0 desliga a validação.
KINECT_VALIDAR=1
# KINECT_ESTADO=/home/usuario/kinect/estado.json
KINECT_PARADO_SEG=30

# --- Sensor mmWave C4001 --------------------------------------------------
# GPIO (BCM) ligado ao pino OUT do sensor.
OUT_GPIO=27

# Inverta para 0 se o painel mostrar presença ao contrário (SIM quando
# vazio, NÃO quando tem alguém).
OUT_ATIVO_ALTO=1

# Quanto tempo sem detecção até marcar "ausente". A detecção de presença é
# imediata; só a ausência tem esse atraso, para não ficar piscando quando a
# pessoa fica parada e o mmWave perde o rastreio por um instante.
ATRASO_AUSENCIA_SEG=3.0

# Se o serviço/Pi reiniciar e voltar dentro desse tempo (segundos),
# presença, contagem e validação são mantidas. Passou disso, começa do zero.
TOLERANCIA_OFFLINE_SEG=300

# Porta do painel HTTP (padrão 8081 - o sensor-pi já usa a 8080 neste mesmo
# Raspberry Pi).
PORTA_WEB=8081

# Endereço em que o painel escuta. 127.0.0.1 = só o próprio Pi (acesso
# externo via Cloudflare Tunnel). Use 0.0.0.0 para liberar na rede local.
HOST_WEB=127.0.0.1

# Baud rate da UART (pinos RX/TX) usada para ajustar alcance/sensibilidade
# pelo painel web ou pelo configurar_sensor.py. Precisa bater com o do
# sensor (padrão de fábrica do C4001 é 9600).
SENSOR_UART_BAUD=9600
